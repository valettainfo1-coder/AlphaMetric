# METRICGYM environment — copy to .env.local
# Leave everything empty for DEMO MODE (IndexedDB + deterministic seed).

# Supabase (EU region project recommended — GDPR)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI coach (Anthropic). Without a key the coach streams deterministic mocks.
ANTHROPIC_API_KEY=

# Product analytics (PostHog EU). Without a key a typed no-op shim is used.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
