# Netlify Security-Header für METRICGYM
# Hinweis: script-src/style-src brauchen 'unsafe-inline', weil die App Inline-
# Handler und Inline-<script>/Styles nutzt. Eine echte Verschärfung erfordert ein
# Refactoring (externe Skripte + Nonces). connect-src/object-src/base-uri/
# frame-ancestors greifen aber sofort und begrenzen Exfiltration & Clickjacking.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://browser.sentry-cdn.com https://plausible.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.openfoodfacts.org; font-src 'self'; connect-src 'self' https://*.supabase.co https://generativelanguage.googleapis.com https://api.groq.com https://openrouter.ai https://*.openfoodfacts.org https://*.ingest.de.sentry.io https://*.ingest.sentry.io https://plausible.io; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()

# config.js darf niemals zwischengespeichert werden (sonst überleben rotierte Keys).
/config.js
  Cache-Control: no-store, max-age=0
